generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ MASTER DATA ============

model Customer {
  id              String   @id @default(cuid())
  companyName     String
  buyerName       String?
  gstNumber       String?
  billingAddress  String?
  shippingAddress String?
  paymentTerms    Int      @default(30)
  creditLimit     Float    @default(0)
  status          String   @default("Active")
  phone           String?
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          SalesOrder[]
  quotations      Quotation[] @relation("CustomerQuotations")
  samples         Sample[]
  costSheets      CostSheet[]
  dispatches      Dispatch[]      @relation("CustomerDispatches")
  catalogs        ClientCatalog[] @relation("CustomerCatalogs")
  sampleCatalogs SampleCatalog[] @relation("CustomerSampleCatalogs")
  invoices        Invoice[]       @relation("CustomerInvoices")
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  supplierType  String   @default("Fabric")
  contactPerson String?
  phone         String?
  email         String?
  paymentTerms  Int      @default(15)
  rating        Int      @default(3)
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  fabricStock    FabricStock[]
  grnNotes       GrnNote[]
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  department  String
  designation String
  skills      String?
  salary      Float
  dailyWage   Float?
  joinDate    DateTime @default(now())
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ PRODUCT MANAGEMENT ============

model Style {
  id             String   @id @default(cuid())
  styleNo        String   @unique
  collectionName String?
  season         String?
  category       String?
  fit            String?
  fabricType     String?
  embroideryType String?
  neckDesign     String?
  sleeveType     String?
  brand          String   @default("Elysé by Dhanya")
  status         String   @default("Active")
  costPrice      Float    @default(0)
  sellPrice      Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderItems     OrderItem[]
}

// ============ SALES MODULE ============

model SalesOrder {
  id              String           @id @default(cuid())
  orderNo         String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  orderDate       DateTime         @default(now())
  deliveryDate    DateTime?
  shippingAddress String?
  status          String           @default("Pending")
  // GST fields
  gstType         String           @default("IntraState") // IntraState (CGST+SGST) or InterState (IGST)
  gstPercent      Float            @default(18)
  taxableAmount   Float            @default(0)
  cgstAmount      Float            @default(0)
  sgstAmount      Float            @default(0)
  igstAmount      Float            @default(0)
  totalGst        Float            @default(0)
  // Broker / Commission
  brokerName      String?
  commissionPercent Float           @default(0)  // e.g. 2, 5 — percentage of totalAmount
  commissionAmount Float            @default(0)  // auto-calculated: totalAmount × commissionPercent / 100
  netAmount       Float            @default(0)  // totalAmount - commissionAmount (what you actually keep)
  // Totals
  totalAmount     Float            @default(0)  // taxableAmount + totalGst - discount
  totalCost       Float            @default(0)
  grossProfit     Float            @default(0)
  grossMargin     Float            @default(0)
  netProfit       Float            @default(0)  // grossProfit - commissionAmount (profit after broker cut)
  netMargin       Float            @default(0)  // netProfit / netAmount × 100
  paymentStatus   String           @default("Unpaid")
  paidAmount      Float            @default(0)
  discountPercent Float            @default(0)
  notes           String?
  quotationId     String?
  items           OrderItem[]
  productionJobs  ProductionJob[]
  dispatches      Dispatch[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  styleId      String?
  style        Style?     @relation(fields: [styleId], references: [id])
  styleName    String
  quantity     Int                 // client order quantity (what customer wants)
  unitPrice    Float
  unitCost     Float
  totalAmount  Float
  totalCost    Float
  profit       Float
  // Production planning (overproduction scenario)
  // e.g. client orders 80 pcs but production runs 120 pcs → surplus 40 goes to FG inventory
  productionQty Int        @default(0)  // what will actually be manufactured
  surplusQty    Int        @default(0)  // productionQty - quantity (auto, goes to FG stock)
  colorBreakdown OrderItemColor[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model OrderItemColor {
  id           String     @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  color        String
  size         String    @default("-")  // size label (S/M/L/XL/XXL or Free)
  quantity     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ============ PURCHASE MODULE ============

model PurchaseOrder {
  id                String    @id @default(cuid())
  poNumber          String    @unique
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  // Vendor linkage — a PO can be raised against a Vendor (job worker /
  // outsourcer) instead of a Supplier (raw material provider). Either
  // supplierId or vendorId should be set, but not both.
  vendorId          String?
  vendor            Vendor?   @relation(fields: [vendorId], references: [id])
  // Product linkage (Sprint 1 — product lifecycle)
  styleNo           String?
  styleName         String?
  costSheetId       String?
  // Legacy single-fabric fields (kept for backward compat)
  fabricName        String
  quantity          Float
  unit              String    @default("meters")
  ratePerUnit       Float
  // GST fields
  gstType           String    @default("IntraState")
  gstPercent        Float    @default(18)
  taxableAmount     Float    @default(0)
  cgstAmount        Float    @default(0)
  sgstAmount        Float    @default(0)
  igstAmount        Float    @default(0)
  totalGst          Float    @default(0)
  totalAmount       Float    @default(0)  // taxableAmount + totalGst
  expectedDelivery  DateTime?
  status            String    @default("Pending")
  paymentStatus     String    @default("Unpaid")
  paidAmount        Float     @default(0)
  receivedQty       Float     @default(0)
  // Multi-fabric line items (Sprint 1)
  items             POItem[]
  grnNotes          GrnNote[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── PO Line Items (multi-fabric, multi-color per PO) ──────────────────────
model POItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  styleNo           String?
  fabricName        String
  color             String?
  quantity          Float
  unit              String   @default("meters")
  ratePerUnit       Float
  totalAmount       Float
  receivedQty       Float    @default(0)
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============ INVENTORY ============

model FabricConsumption {
  id                 String   @id @default(cuid())
  consumptionNo      String   @unique
  productionJobId    String
  productionJob      ProductionJob @relation(fields: [productionJobId], references: [id])
  fabricStockId      String
  fabricStock        FabricStock   @relation(fields: [fabricStockId], references: [id])
  fabricName         String
  issuedQty          Float    @default(0)
  consumedQty        Float    @default(0)
  wastageQty         Float    @default(0)
  wastagePercent     Float    @default(0)
  plannedQty         Float    @default(0)
  varianceVsPlan     Float    @default(0)
  outputQty          Int      @default(0)
  consumptionPerPc   Float    @default(0)
  wastageReason      String?
  wastageRemarks     String?
  recordedBy         String?
  consumptionDate    DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productionJobId])
  @@index([fabricStockId])
}

model StockReservation {
  id               String    @id @default(cuid())
  reservationNo    String    @unique
  fabricStockId    String
  fabricStock      FabricStock @relation(fields: [fabricStockId], references: [id])
  referenceType    String    // SalesOrder, ProductionJob
  referenceId      String
  referenceNo      String
  reservedQty      Float     @default(0)
  consumedQty      Float     @default(0)
  status           String    @default("Active") // Active, Partially Consumed, Fully Consumed, Released, Expired
  expiryDate       DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([fabricStockId])
  @@index([status])
}

model FabricStock {
  id            String   @id @default(cuid())
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  fabricName    String
  gsm           Int?
  width         Float?
  lotNumber     String?
  availableMeters Float   @default(0)
  reservedMeters Float   @default(0)
  averageCost   Float    @default(0)
  totalValue    Float    @default(0)
  productionJobs   ProductionJob[]
  fabricConsumptions FabricConsumption[]
  stockReservations  StockReservation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ FINISHED GOODS INVENTORY ============

// ── 1. FGStockBin ──────────────────────────────────────────────
// The SINGLE SOURCE OF TRUTH for finished goods stock.
// One row per Style × Color × Size combination.

model FGStockBin {
  id              String   @id @default(cuid())
  styleNo         String                        // Main style ID (from Sample) — e.g., "DH-01"
  styleName       String                        // Denormalized — e.g., "Cotton Print Kurti"
  colorCode       String                        // Auto-generated sub-ID — e.g., "DH-01-PK01"
  color           String                        // Human-readable — e.g., "Pink"
  size            String                        // e.g., "XS", "S", "M", "L", "XL", "Free"

  // ── Quantity Buckets ──
  availableQty    Int      @default(0)          // Ready to sell
  reservedQty     Int      @default(0)          // Locked against orders
  qcPendingQty    Int      @default(0)          // Awaiting quality check
  underRepairQty  Int      @default(0)          // Being repaired
  defectiveQty    Int      @default(0)          // Failed QC
  scrappedQty     Int      @default(0)          // Written off permanently
  exhibitionQty   Int      @default(0)          // At exhibition/event

  // ── Pricing ──
  unitCost        Float    @default(0)          // From CostSheet or GRN
  unitSellPrice   Float    @default(0)          // From Style.sellPrice or CostSheet.sellingPrice

  // ── Metadata ──
  image           String?                       // Cloudinary URL from Sample/CostSheet
  firstInDate     DateTime?                     // First stock inward date
  lastMovementDate DateTime?                    // Last stock movement date
  location        String   @default("Warehouse") // Warehouse, Exhibition, Vendor
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ── Relations ──
  stockMovements  FGStockMovement[]
  fgReservations   FGReservation[]

  @@unique([styleNo, color, size])             // One bin per Style×Color×Size
  @@index([styleNo])
  @@index([colorCode])
  @@index([color])
}

// ── 2. FGStockMovement ─────────────────────────────────────────
// Immutable append-only transaction log.

model FGStockMovement {
  id              String   @id @default(cuid())
  movementNo      String   @unique             // FGM-YYYYMMDD-XXX
  movementType    String                        // See 12 types

  // ── Stock Bin Reference ──
  fgStockBinId    String
  fgStockBin      FGStockBin @relation(fields: [fgStockBinId], references: [id])

  // ── Denormalized for fast query ──
  styleNo         String
  styleName       String
  colorCode       String
  color           String
  size            String

  // ── Quantities ──
  quantity        Int                           // Positive for inward, negative for outward
  previousQty     Int                           // availableQty BEFORE this movement
  newQty          Int                           // availableQty AFTER this movement
  unitCost        Float    @default(0)

  // ── Source Document ──
  referenceType   String?                       // SalesOrder, Dispatch, Return, FGGrnNote, FGReservation, Adjustment, QC
  referenceId     String?
  referenceNo     String?                       // Human-readable (SO-xxx, DSP-xxx, FGRN-xxx)

  // ── Status Transition (for QC changes, exchanges) ──
  fromStatus      String?
  toStatus        String?

  // ── Location Transition (for exhibition) ──
  fromLocation    String?
  toLocation      String?

  // ── Party ──
  partyId         String?
  partyName       String?

  // ── Context ──
  reason          String?                       // Free-text (adjustments, scrapping)
  movedBy         String?                       // "System" or user name
  movedAt         DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([fgStockBinId])
  @@index([movementType])
  @@index([styleNo])
  @@index([colorCode])
  @@index([referenceType, referenceId])
  @@index([movedAt])
}

// ── 3. FGReservation ──────────────────────────────────────────

model FGReservation {
  id              String     @id @default(cuid())
  reservationNo   String     @unique             // FGRV-YYYYMMDD-XXX
  salesOrderId    String
  salesOrderNo    String
  customerId      String?
  customerName    String?
  fgStockBinId    String
  fgStockBin      FGStockBin @relation(fields: [fgStockBinId], references: [id])
  styleNo         String
  colorCode       String
  color           String
  size            String
  reservedQty     Int        @default(0)
  dispatchedQty   Int        @default(0)
  status          String     @default("Active") // Active, PartiallyDispatched, FullyDispatched, Released, Expired
  reservedDate    DateTime   @default(now())
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([salesOrderId])
  @@index([fgStockBinId])
  @@index([status])
}

// ── 4. FGGrnNote ───────────────────────────────────────────────

model FGGrnNote {
  id              String      @id @default(cuid())
  grnNo           String      @unique             // FGRN-YYYYMMDD-XXX
  sourceType      String                          // "Vendor" or "Production"
  sourceId        String?
  sourceNo        String?
  sourceName      String
  styleNo         String
  styleName       String
  image           String?
  receivedDate    DateTime    @default(now())
  status          String      @default("Draft")  // Draft, Pending QC, Approved, Rejected
  totalReceivedQty Int       @default(0)
  totalAcceptedQty Int       @default(0)
  totalRejectedQty Int       @default(0)
  unitCost        Float      @default(0)
  unitSellPrice   Float      @default(0)
  notes           String?
  items           FGGrnItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([styleNo])
  @@index([status])
  @@index([sourceType])
}

// ── 5. FGGrnItem ──────────────────────────────────────────────

model FGGrnItem {
  id              String     @id @default(cuid())
  fgGrnNoteId     String
  fgGrnNote       FGGrnNote @relation(fields: [fgGrnNoteId], references: [id], onDelete: Cascade)
  color           String
  size            String
  colorCode       String                         // Auto-generated at GRN creation
  receivedQty     Int        @default(0)
  acceptedQty     Int        @default(0)
  rejectedQty     Int        @default(0)
  defectNotes     String?
  unitCost        Float      @default(0)
  totalValue      Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([fgGrnNoteId])
}

// ── 6. FGPromotionalIssue ─────────────────────────────────────

model FGPromotionalIssue {
  id              String     @id @default(cuid())
  issueNo         String     @unique             // FPI-YYYYMMDD-XXX
  customerId      String?
  customerName    String?
  purpose         String?
  referenceNo     String?
  totalQty        Int        @default(0)
  totalCostValue  Float      @default(0)
  status          String     @default("Issued")  // Issued, PartiallyReturned, Returned
  issuedDate      DateTime   @default(now())
  notes           String?
  items           FGPromotionalItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([customerId])
  @@index([status])
}

model FGPromotionalItem {
  id                String   @id @default(cuid())
  promotionalIssueId String
  promotionalIssue  FGPromotionalIssue @relation(fields: [promotionalIssueId], references: [id], onDelete: Cascade)
  fgStockBinId      String
  styleNo           String
  colorCode         String
  color             String
  size              String
  quantity          Int     @default(0)
  unitCost          Float   @default(0)
  totalValue        Float   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── 7. FGExhibition ──────────────────────────────────────────

model FGExhibition {
  id              String     @id @default(cuid())
  exhibitionNo    String     @unique             // FEX-YYYYMMDD-XXX
  exhibitionName  String
  location        String?
  startDate       DateTime
  expectedReturn  DateTime?
  actualReturn    DateTime?
  totalPieces     Int        @default(0)
  totalValue      Float      @default(0)
  status          String     @default("Active") // Active, Returned, Overdue
  notes           String?
  items           FGExhibitionItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
}

model FGExhibitionItem {
  id              String     @id @default(cuid())
  exhibitionId    String
  exhibition      FGExhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  fgStockBinId    String
  styleNo         String
  colorCode       String
  color           String
  size            String
  quantity        Int        @default(0)
  returnedQty     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([exhibitionId])
  @@index([fgStockBinId])
}

// ============ PRODUCTION ============

model ProductionJob {
  id            String          @id @default(cuid())
  jobNo         String          @unique
  salesOrderId  String?
  salesOrder    SalesOrder?     @relation(fields: [salesOrderId], references: [id])
  styleNo       String
  styleName     String
  targetQty     Int
  completedQty  Int             @default(0)
  stage         String          @default("Fabric Issue")
  startDate     DateTime        @default(now())
  endDate       DateTime?
  status        String          @default("In Progress")
  // Fabric tracking
  plannedFabricMeters   Float    @default(0)
  actualFabricConsumed  Float    @default(0)
  fabricStockId         String?
  fabricStock           FabricStock? @relation(fields: [fabricStockId], references: [id])
  // Cost tracking (Sprint 1 — actual vs estimated)
  costSheetId           String?
  actualFabricCost      Float    @default(0)
  actualLaborCost       Float    @default(0)
  actualOverheadCost    Float    @default(0)
  totalActualCost       Float    @default(0)
  qualityChecks   QualityCheck[]
  stageTrackings  StageTracking[]
  fabricConsumptions FabricConsumption[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ============ OUTSOURCING / VENDORS ============

model Vendor {
  id              String          @id @default(cuid())
  vendorName      String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  gstNumber       String?                 // GSTIN for tax invoices
  state           String?                 // state (for GST place-of-supply)
  vendorType      String          @default("Job Worker")  // type of vendor (customizable)
  specialization  String          @default("")
  paymentTerms    Int             @default(30)  // Payment cycle in days (30, 45, 60, etc.)
  status          String          @default("Active")
  purchaseOrders  PurchaseOrder[]
  stageTrackings  StageTracking[]
  vendorBills     VendorBill[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model StageTracking {
  id                 String   @id @default(cuid())
  productionJobId    String
  productionJob      ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  stageName          String
  sequence           Int
  locationType       String   @default("In-House")
  vendorId           String?
  vendor             Vendor?  @relation(fields: [vendorId], references: [id])
  sentDate           DateTime?
  expectedReturnDate DateTime?
  receivedDate       DateTime?
  sentQty            Int      @default(0)
  receivedQty        Int      @default(0)
  defectiveQty       Int      @default(0)
  perPieceRate       Float    @default(0)   // Rate agreed per piece for this stage
  totalAmount        Float    @default(0)   // Auto-calculated: receivedQty × perPieceRate
  status             String   @default("Pending")
  notes              String?
  vendorBills        VendorBill[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productionJobId, stageName])
}

// ============ VENDOR BILLING & PAYMENTS ============

model VendorBill {
  id              String           @id @default(cuid())
  billNo          String           @unique
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id])
  stageTrackingId String?
  stageTracking   StageTracking?   @relation(fields: [stageTrackingId], references: [id])
  description     String            // e.g. "Embroidery - 100 pcs × ₹15"
  totalQty        Int              @default(0)
  perPieceRate    Float            @default(0)
  // GST fields
  gstType         String           @default("IntraState")
  gstPercent      Float            @default(18)
  taxableAmount   Float            @default(0)
  cgstAmount      Float            @default(0)
  sgstAmount      Float            @default(0)
  igstAmount      Float            @default(0)
  totalGst        Float            @default(0)
  totalAmount     Float            @default(0)  // taxableAmount + totalGst
  paidAmount      Float            @default(0)
  billDate        DateTime         @default(now())
  dueDate         DateTime?
  status          String           @default("Pending") // Pending, Partially Paid, Paid, Overdue, Cancelled
  notes           String?
  payments        VendorPayment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model VendorPayment {
  id              String      @id @default(cuid())
  paymentNo       String      @unique
  vendorBillId    String
  vendorBill      VendorBill  @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  vendorId        String
  amount          Float
  paymentDate     DateTime    @default(now())
  paymentMethod   String      @default("Bank Transfer") // Cash, UPI, Bank Transfer, Cheque
  referenceNo     String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ============ GRN (GOODS RECEIVED NOTE) ============

model GrnNote {
  id              String     @id @default(cuid())
  grnNo           String     @unique
  poId            String?
  purchaseOrder   PurchaseOrder? @relation(fields: [poId], references: [id])
  supplierId      String?
  supplier        Supplier?  @relation(fields: [supplierId], references: [id])
  supplierName    String     // Denormalized for easy display
  receivedDate    DateTime   @default(now())
  status          String     @default("Draft") // Draft, Inspected, Approved, Rejected
  totalReceivedQty Float     @default(0)
  acceptedQty     Float      @default(0)
  rejectedQty     Float      @default(0)
  qualityRemarks  String?
  notes           String?
  grnItems        GrnItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([poId])
  @@index([status])
}

model GrnItem {
  id              String   @id @default(cuid())
  grnId           String
  grnNote         GrnNote  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  fabricName      String
  orderedQty      Float
  receivedQty     Float
  acceptedQty     Float
  rejectedQty     Float
  defectNotes     String?
  ratePerUnit     Float
  totalValue      Float    @default(0)  // acceptedQty × ratePerUnit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([grnId])
}

// ============ DISPATCH / SHIPPING ============

model Dispatch {
  id              String         @id @default(cuid())
  dispatchNo      String         @unique
  salesOrderId    String
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id])
  productionJobId String?        // Sprint 3: link to production job
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], name: "CustomerDispatches")
  dispatchDate    DateTime       @default(now())
  status          String         @default("Packed") // Packed, InTransit, Delivered
  shippingAddress String?
  trackingNo      String?
  transporter     String?
  vehicleNo       String?
  totalDispatchedQty Int         @default(0)
  notes           String?
  dispatchItems   DispatchItem[]
  invoices        Invoice[]      // Sprint 3: invoices generated from this dispatch
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([salesOrderId])
  @@index([status])
}

model DispatchItem {
  id              String   @id @default(cuid())
  dispatchId      String
  dispatch        Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  styleNo         String
  styleName       String
  orderedQty      Int
  dispatchedQty   Int
  color           String?                       // e.g., "Pink"
  colorCode       String?                       // e.g., "DH-01-PK01"
  size            String?                       // e.g., "S", "M", "L"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dispatchId])
}

// ============ RETURNS ============

model Return {
  id              String       @id @default(cuid())
  returnNo        String       @unique
  returnType      String       // Customer, Supplier
  referenceId     String       // salesOrderId or purchaseOrderId or vendorBillId
  referenceNo     String       // SO-xxx or PO-xxx or VB-xxx (denormalized)
  partyName       String       // Customer or Supplier name (denormalized)
  reason          String
  status          String       @default("Requested") // Requested, Approved, Processed, Rejected
  totalQty        Int          @default(0)
  totalValue      Float        @default(0)
  refundAmount    Float        @default(0)
  notes           String?
  returnItems     ReturnItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([returnType])
  @@index([status])
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnId        String
  return          Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemName        String
  styleNo         String?
  quantity        Int
  unitValue       Float
  totalValue      Float    @default(0)
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([returnId])
}

// ============ PRODUCT COSTING ============

model CostCategory {
  id         String   @id @default(cuid())
  name       String   @unique
  colorIndex Int      @default(0)   // Index into frontend color palette
  sortOrder  Int      @default(0)
  isSystem   Boolean  @default(false) // Pre-seeded categories cannot be deleted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CostSheet {
  id            String   @id @default(cuid())
  sheetNo       String   @unique
  styleNo       String
  styleName     String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  description   String?
  sizeRange     String?
  targetQty     Int      @default(0)
  fabricCost    Float    @default(0)
  trimCost      Float    @default(0)
  laborCost     Float    @default(0)
  washCost      Float    @default(0)
  packagingCost Float    @default(0)
  overheadCost  Float    @default(0)
  otherCost     Float    @default(0)
  totalCost     Float    @default(0)
  profitPercent         Float    @default(30)
  sellingPrice           Float    @default(0)
  brokerCommissionPercent Float    @default(0)
  brokerCommissionAmount Float    @default(0)
  status                 String   @default("Draft")
  image          String?                          // Base64 image for design photo
  notes         String?
  costItems     CostItem[]
  colorBreakdown CostSheetColor[]
  catalogItems  ClientCatalogItem[]              // Which catalogs include this cost sheet
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CostSheetColor {
  id          String    @id @default(cuid())
  costSheetId String
  costSheet   CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  color       String
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CostItem {
  id            String    @id @default(cuid())
  costSheetId   String
  costSheet     CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  category      String
  itemName      String
  description   String?
  consumption   Float     @default(0)
  unit          String    @default("pcs")
  unitRate      Float     @default(0)
  wastagePercent Float    @default(5)
  itemCost      Float     @default(0)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ BROKER MANAGEMENT ============

model Broker {
  id            String           @id @default(cuid())
  name          String
  phone         String?
  commissionPercent Float        @default(5)
  address       String?
  notes         String?
  status        String           @default("Active")
  catalogs      ClientCatalog[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ============ CLIENT CATALOG (Costing Selection for Client) ============

model ClientCatalog {
  id            String             @id @default(cuid())
  catalogNo     String             @unique
  customerId    String
  customer      Customer           @relation("CustomerCatalogs", fields: [customerId], references: [id])
  brokerId      String?
  broker        Broker?            @relation(fields: [brokerId], references: [id])
  date          DateTime           @default(now())
  status        String             @default("Draft")   // Draft, Sent, Converted
  notes         String?
  items         ClientCatalogItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ClientCatalogItem {
  id            String       @id @default(cuid())
  catalogId     String
  catalog       ClientCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  costSheetId   String
  costSheet     CostSheet    @relation(fields: [costSheetId], references: [id])
  discountPercent Float      @default(0)
  // Calculated at save time (not stored — computed from costSheet + discount + broker)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([catalogId, costSheetId])
}

// ============ FINANCE / TRANSACTIONS ============

model Transaction {
  id            String   @id @default(cuid())
  type          String
  category      String
  amount        Float
  description   String
  referenceNo   String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ DAILY SNAPSHOT ============

model DailySnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique
  revenue       Float    @default(0)
  expenses      Float    @default(0)
  grossProfit   Float    @default(0)
  netProfit     Float    @default(0)
  cashIn        Float    @default(0)
  cashOut       Float    @default(0)
  receivables   Float    @default(0)
  payables      Float    @default(0)
  cashBalance   Float    @default(0)
  inventoryValue Float   @default(0)
  ordersCount   Int      @default(0)
  productionQty Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ QUOTATIONS ============

model Quotation {
  id              String   @id @default(cuid())
  quotationNo     String   @unique
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], name: "CustomerQuotations")
  quotationDate   DateTime @default(now())
  validUntil      DateTime
  status          String   @default("Draft") // Draft, Sent, Accepted, Rejected, Converted
  // GST fields
  gstType         String   @default("IntraState")
  gstPercent      Float    @default(18)
  taxableAmount   Float    @default(0)
  cgstAmount      Float    @default(0)
  sgstAmount      Float    @default(0)
  igstAmount      Float    @default(0)
  totalGst        Float    @default(0)
  totalAmount     Float    @default(0)  // taxableAmount + totalGst - discount
  totalCost       Float    @default(0)
  discountPercent Float    @default(0)
  notes           String?
  convertedOrderId String?
  items           QuotationItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  styleName    String
  quantity     Int
  unitPrice    Float
  unitCost     Float
  totalAmount  Float
  totalCost    Float
  profit       Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ QUALITY CONTROL ============

model QualityCheck {
  id             String   @id @default(cuid())
  checkNo        String   @unique
  productionJobId String
  productionJob  ProductionJob @relation(fields: [productionJobId], references: [id])
  inspectionPoint String   // Fabric Check, Cutting Check, In-Process Check, Finishing Check, Final Inspection
  checkedQty     Int      @default(0)
  passedQty      Int      @default(0)
  failedQty      Int      @default(0)
  defectType     String?
  defectCount    Int      @default(0)
  severity       String   @default("Minor") // Minor, Major, Critical
  status         String   @default("Pass")  // Pass, Fail, Conditional
  inspectorName  String?
  notes          String?
  checkedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============ SAMPLING ============

model Sample {
  id            String          @id @default(cuid())
  sampleNo      String          @unique
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  styleNo       String
  styleName     String
  stage         String          @default("Design") // Design, Fabric Sourcing, Pattern Making, Cutting, Stitching, Finishing, Ready
  status        String          @default("In Progress") // In Progress, Submitted, Approved, Rejected, Revised
  assignedTo    String?
  submissionDate DateTime?
  approvedDate  DateTime?
  cost          Float          @default(0)
  notes         String?
  photos        SamplePhoto[]
  catalogItems  SampleCatalogItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model SamplePhoto {
  id          String   @id @default(cuid())
  sampleId    String
  sample      Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  imageUrl    String                // Base64 data URI of hi-res photo
  caption     String?               // e.g. "Front View", "Back View", "Detail"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sampleId])
}

// ============ SAMPLE CATALOG (Photo catalog sent to clients) ============

model SampleCatalog {
  id            String               @id @default(cuid())
  catalogNo     String               @unique
  customerId    String
  customer      Customer             @relation("CustomerSampleCatalogs", fields: [customerId], references: [id])
  sentDate      DateTime             @default(now())
  status        String               @default("Draft") // Draft, Sent
  notes         String?
  items         SampleCatalogItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model SampleCatalogItem {
  id          String        @id @default(cuid())
  catalogId   String
  catalog     SampleCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  sampleId    String
  sample      Sample        @relation(fields: [sampleId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([catalogId, sampleId])
}

// ============ BUSINESS ALERTS ============

model Alert {
  id        String   @id @default(cuid())
  type      String
  severity  String   @default("warning")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ AI AGENT PERSISTENCE ============

model AgentConversation {
  id        String   @id @default(cuid())
  title     String?
  role      String   @default("founder")
  messages  String   // JSON array: Array<{role, content, timestamp}>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentFeedback {
  id             String   @id @default(cuid())
  conversationId String?
  userMessage    String
  agentResponse  String
  toolCallsJson  String?  // JSON: array of tool call details
  rating         String   // "up" | "down"
  comment        String?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String?
  entityNo       String?
  action         String
  changes        String?  // JSON string of field-level changes
  toolName       String?
  userMessage    String?
  confirmation   String?
  conversationId String?
  createdAt      DateTime @default(now())
}

// ============ EVAL HARNESS ============

model EvalRun {
  id            String       @id @default(cuid())
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  version       String       @default("6.2")
  totalTests    Int          @default(0)
  passed        Int          @default(0)
  failed        Int          @default(0)
  errors        Int          @default(0)
  accuracy      Float        @default(0)
  avgLatencyMs  Int          @default(0)
  results       EvalResult[]
  createdAt     DateTime     @default(now())
}

model EvalResult {
  id              String   @id @default(cuid())
  evalRunId       String
  testId          String
  query           String
  category        String
  difficulty      String   @default("medium")
  expectedTools   String   // JSON array
  actualTools     String   // JSON array
  toolAccuracy    Boolean  @default(false)
  partialAccuracy Float    @default(0)
  response        String   @default("")
  latencyMs       Int      @default(0)
  error           String?
  evalRun         EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}
// ─── Company Settings (White-Label Configuration) ───────────────────────────
// Allows any brand to customize company info shown in PDFs, UI, etc.
model CompanySettings {
  id            String   @id @default("default")
  companyName   String   @default("Dhanya Lifestyle LLP")
  brandName     String?
  tagline       String?
  location      String   @default("Surat, Gujarat, India")
  phone         String?
  email         String?
  website       String?
  gstNumber     String?
  logoUrl       String?
  primaryColor  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── INVOICE & PAYMENT (Sprint 3 — full pipeline) ──────────────────────────

model Invoice {
  id              String    @id @default(cuid())
  invoiceNo       String    @unique
  salesOrderId    String?
  dispatchId      String?
  dispatch        Dispatch? @relation(fields: [dispatchId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], name: "CustomerInvoices")
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  paymentStatus   String    @default("Unpaid") // Unpaid, Partial, Paid
  paymentTerms    Int       @default(0) // credit days (0 = immediate)
  dueDate         DateTime?
  invoiceDate     DateTime  @default(now())
  notes           String?
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([salesOrderId])
  @@index([customerId])
  @@index([paymentStatus])
}

model Payment {
  id              String    @id @default(cuid())
  paymentNo       String    @unique
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Float     @default(0)
  paymentDate     DateTime  @default(now())
  paymentMode     String    @default("Cash") // Cash, UPI, Bank Transfer, Cheque, Other
  referenceNo     String?   // UPI ref, cheque no, etc.
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
}
